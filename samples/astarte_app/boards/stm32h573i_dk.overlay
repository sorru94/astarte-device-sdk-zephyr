&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
        #size-cells = <1>;

		astarte_partition: partition@100000 {
			label = "astarte";
			reg = <0x00100000 DT_SIZE_K(128)>;
		};
	};
};
